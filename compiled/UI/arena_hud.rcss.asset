/*
 * Spell Arena HUD. Dark glass panels over the game; each spell brings its own accent colour
 * through the data model (data-style-color / data-style-border-color).
 * Lengths are in rem: 1rem is the body's font size, 16dp, which ArenaHud.cs grows with the
 * screen's density on a touch screen, so the whole HUD scales with it and its text stays sharp.
 * RCSS reminders: colours with alpha as #rrggbbaa, borders take no style keyword.
 */

html, body {
	width: 100vw;
	height: 100vh;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: Inter;
	font-size: 16dp;
	color: #e8e4f4;
	background-color: rgba(0, 0, 0, 0);
	pointer-events: none;
}

.panel {
	position: absolute;
	box-sizing: border-box;
	padding: 0.875rem 1.125rem;
	background-color: #0b0a14c8;
	border: 0.0625rem #ffffff26;
	border-radius: 0.5rem;
}

/* ---------- title ---------- */

#title {
	top: 1.5rem;
	left: 1.5rem;
}

.heading {
	font-size: 1.875rem;
	font-weight: bold;
	color: #f4e9ff;
}

.subheading {
	font-size: 0.875rem;
	color: #a79fc4;
}

/* ---------- live count and switches ---------- */

#stats {
	top: 1.5rem;
	right: 1.5rem;
	width: 18.75rem;
}

.count {
	font-size: 2.5rem;
	font-weight: bold;
	color: #ffffff;
	text-align: right;
}

.count-label {
	font-size: 0.8125rem;
	color: #a79fc4;
	text-align: right;
	margin-bottom: 0.625rem;
}

/* A switch is a button: a click or a tap on its row turns it. Its state floats right, exactly as tall
   as the row: clearing keeps one row's float from pushing the next row's aside. */
.switch {
	display: block;
	clear: both;
	height: 1.625rem;
	line-height: 1.625rem;
	padding: 0dp 0.25rem;
	border-radius: 0.25rem;
	color: #8d86a8;
	pointer-events: auto;
}

.switch:hover {
	background-color: #ffffff12;
}

.switch.on {
	color: #ffffff;
}

.switch .label {
	margin-left: 0.625rem;
}

.switch .state {
	float: right;
	font-weight: bold;
}

.switch.on .state {
	color: #ffd77a;
}

.key {
	display: inline-block;
	width: 1.375rem;
	height: 1.375rem;
	line-height: 1.375rem;
	text-align: center;
	font-size: 0.8125rem;
	font-weight: bold;
	color: #ffffff;
	background-color: #ffffff1c;
	border: 0.0625rem #ffffff40;
	border-radius: 0.25rem;
}

.key.wide {
	width: 5.75rem;
	margin-right: 0.625rem;
}

/* ---------- controls ---------- */

#controls {
	bottom: 1.5rem;
	left: 1.5rem;
}

#touch-controls {
	display: none;
	top: 1.5rem;
	left: 1.5rem;
}

.control {
	display: block;
	height: 1.75rem;
	line-height: 1.75rem;
	font-size: 0.875rem;
	color: #c9c2e0;
}

/* ---------- spell bar ---------- */

#spellbook {
	position: absolute;
	bottom: 1.5rem;
	left: 0dp;
	right: 0dp;
	text-align: center;
}

#details {
	position: relative;
	display: inline-block;
	width: 35rem;
	margin-bottom: 0.75rem;
	text-align: center;
}

.spell-name {
	font-size: 1.5rem;
	font-weight: bold;
}

.spell-description {
	font-size: 0.9375rem;
	color: #c9c2e0;
}

#bar {
	display: block;
}

/* A slot is a button: a click or a tap selects its spell. */
.slot {
	display: inline-block;
	width: 8.25rem;
	height: 4rem;
	margin: 0dp 0.3125rem;
	padding-top: 0.5rem;
	box-sizing: border-box;
	background-color: #0b0a14b4;
	border: 0.125rem #ffffff30;
	border-radius: 0.5rem;
	text-align: center;
	pointer-events: auto;
}

.slot:hover {
	background-color: #1a1530d8;
}

.slot.selected {
	background-color: #241c3ce6;
}

.slot-key {
	font-size: 1.25rem;
	font-weight: bold;
}

.slot-name {
	font-size: 0.875rem;
	color: #d8d2ea;
}

/* ---------- touch screens ---------- */

/* No keyboard: touch hints take the title's place, switches lose their keys and grow for a finger. */
body.touch #title,
body.touch #controls {
	display: none;
}

body.touch #touch-controls {
	display: block;
}

body.touch #stats {
	width: 13rem;
}

body.touch .switch {
	height: 2.5rem;
	line-height: 2.5rem;
}

body.touch .switch .key {
	display: none;
}

body.touch .switch .label {
	margin-left: 0;
}
