/*
 * Spell Arena HUD. Dark glass panels over the game; each spell brings its own accent colour
 * through the data model (data-style-color / data-style-border-color).
 * Lengths are in rem, so the whole HUD scales with the body's font size and its text stays sharp:
 * 16dp, which is the same apparent size on any screen, and on a short screen a share of its height.
 * RCSS reminders: colours with alpha as #rrggbbaa, borders take no style keyword.
 */

html, body {
	width: 100vw;
	height: 100vh;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
	font-family: Inter;
	font-size: 16dp;
	color: #e8e4f4;
	background-color: rgba(0, 0, 0, 0);
	pointer-events: none;
}

#hud {
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
}

.panel {
	position: absolute;
	box-sizing: border-box;
	padding: 0.875rem 1.125rem;
	background-color: #0b0a14c8;
	border: 0.0625rem #ffffff26;
	border-radius: 0.5rem;
}

/* ---------- title ---------- */

#title {
	top: 1.5rem;
	left: 1.5rem;
}

.heading {
	font-size: 1.875rem;
	font-weight: bold;
	color: #f4e9ff;
}

.subheading {
	font-size: 0.875rem;
	color: #a79fc4;
}

/* ---------- live count and switches ---------- */

#stats {
	top: 1.5rem;
	right: 1.5rem;
	width: 18.75rem;
}

#live {
	text-align: right;
	margin-bottom: 0.625rem;
}

.count {
	display: block;
	font-size: 2.5rem;
	font-weight: bold;
	color: #ffffff;
}

.count-label {
	display: block;
	font-size: 0.8125rem;
	color: #a79fc4;
}

/* A switch is a button: a click or a tap on its row turns it. Its state floats right, exactly as tall
   as the row: clearing keeps one row's float from pushing the next row's aside. */
.switch {
	display: block;
	clear: both;
	height: 1.625rem;
	line-height: 1.625rem;
	padding: 0dp 0.25rem;
	border-radius: 0.25rem;
	color: #8d86a8;
	pointer-events: auto;
}

.switch:hover {
	background-color: #ffffff12;
}

.switch.on {
	color: #ffffff;
}

.switch .label {
	margin-left: 0.625rem;
}

.switch .state {
	float: right;
	font-weight: bold;
}

.switch.on .state {
	color: #ffd77a;
}

.key {
	display: inline-block;
	width: 1.375rem;
	height: 1.375rem;
	line-height: 1.375rem;
	text-align: center;
	font-size: 0.8125rem;
	font-weight: bold;
	color: #ffffff;
	background-color: #ffffff1c;
	border: 0.0625rem #ffffff40;
	border-radius: 0.25rem;
}

.key.wide {
	width: 5.75rem;
	margin-right: 0.625rem;
}

/* ---------- controls ---------- */

#controls {
	bottom: 1.5rem;
	left: 1.5rem;
}

#touch-controls {
	display: none;
	top: 1.5rem;
	left: 1.5rem;
}

.control {
	display: block;
	height: 1.75rem;
	line-height: 1.75rem;
	font-size: 0.875rem;
	color: #c9c2e0;
}

/* ---------- spell bar ---------- */

#spellbook {
	position: absolute;
	bottom: 1.5rem;
	left: 0dp;
	right: 0dp;
	text-align: center;
}

#details {
	position: relative;
	display: inline-block;
	width: 35rem;
	margin-bottom: 0.75rem;
	text-align: center;
}

.spell-name {
	font-size: 1.5rem;
	font-weight: bold;
}

.spell-description {
	font-size: 0.9375rem;
	color: #c9c2e0;
}

#bar {
	display: block;
}

/* A slot is a button: a click or a tap selects its spell. */
.slot {
	display: inline-block;
	width: 8.25rem;
	height: 4rem;
	margin: 0dp 0.3125rem;
	padding-top: 0.5rem;
	box-sizing: border-box;
	background-color: #0b0a14b4;
	border: 0.125rem #ffffff30;
	border-radius: 0.5rem;
	text-align: center;
	pointer-events: auto;
}

.slot:hover {
	background-color: #1a1530d8;
}

.slot.selected {
	background-color: #241c3ce6;
}

.slot-key {
	font-size: 1.25rem;
	font-weight: bold;
}

.slot-name {
	font-size: 0.875rem;
	color: #d8d2ea;
}

/* ---------- touch screens ---------- */

/* No keyboard: touch hints take the title's place, switches and slots lose their keys. */
body.touch #title,
body.touch #controls,
body.touch .switch .key,
body.touch .slot-key {
	display: none;
}

body.touch #touch-controls {
	display: block;
}

body.touch #stats {
	width: 13rem;
}

body.touch .switch {
	height: 2.5rem;
	line-height: 2.5rem;
}

body.touch .switch .label {
	margin-left: 0dp;
}

/* ---------- short screens: a phone in landscape ---------- */

/* About 384 dp tall. One strip of switches along the top and one row of spells along the bottom leave the
   arena in view. A switch shows its state by its colour, a slot its spell by its name. The layout needs
   46 x 26 rem between the margins: 1rem is 1/26 of the height, or on a narrower shape 1/46 of the width
   between the margins. The side margins keep it clear of a camera cutout, on either side of a turned phone. */
@media (max-height: 500dp) {
	body {
		font-size: 3.846vh;
	}

	#hud {
		left: 4.5vw;
		right: 4.5vw;
	}

	#hud #title,
	#hud #controls,
	#hud .long,
	#hud .switch .key,
	#hud .switch .state,
	#hud .slot-key,
	#hud .spell-name {
		display: none;
	}

	#hud #stats {
		top: 0.5rem;
		left: 0dp;
		right: 0dp;
		width: auto;
		padding: 0dp;
		background-color: rgba(0, 0, 0, 0);
		border-width: 0dp;
	}

	#hud #live {
		position: absolute;
		left: 0dp;
		top: 0dp;
		margin: 0dp;
		padding: 0.25rem 0.625rem;
		text-align: left;
		background-color: #0b0a14c8;
		border-radius: 0.5rem;
	}

	#hud .count {
		display: inline;
		font-size: 1.25rem;
	}

	#hud .count-label {
		display: inline;
		margin-left: 0.25rem;
	}

	#hud #switches {
		position: absolute;
		right: 0dp;
		top: 0dp;
		text-align: right;
	}

	#hud .switch {
		display: inline-block;
		clear: none;
		height: 3rem;
		line-height: 3rem;
		margin-left: 0.25rem;
		padding: 0dp 0.75rem;
		font-size: 0.875rem;
		background-color: #0b0a14c8;
		border-radius: 0.5rem;
	}

	#hud .switch.on {
		background-color: #5a4a1ee6;
		color: #ffd77a;
	}

	#hud .switch .label {
		margin-left: 0dp;
	}

	#hud #touch-controls {
		top: 2.75rem;
		left: 0dp;
		padding: 0.125rem 0.625rem;
		background-color: rgba(0, 0, 0, 0);
		border-width: 0dp;
	}

	#hud .control {
		height: 1.5rem;
		line-height: 1.5rem;
		font-size: 0.75rem;
	}

	#hud .key.wide {
		width: 3rem;
		height: 1.25rem;
		line-height: 1.25rem;
		margin-right: 0.375rem;
		font-size: 0.6875rem;
	}

	#hud #spellbook {
		bottom: 0.5rem;
	}

	#hud #details {
		width: auto;
		margin-bottom: 0.25rem;
		padding: 0.125rem 0.625rem;
		border-width: 0dp;
	}

	#hud .spell-description {
		font-size: 0.8125rem;
	}

	#hud .slot {
		width: 7.25rem;
		height: 3.25rem;
		margin: 0dp 0.125rem;
		padding-top: 0dp;
	}

	#hud .slot-name {
		line-height: 3rem;
	}
}

@media (max-height: 500dp) and (max-aspect-ratio: 194/100) {
	body {
		font-size: 1.978vw;
	}
}
